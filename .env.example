# Backend/API — nunca coloque estes valores no frontend ou no GitHub Pages
DATABASE_URL="postgresql://bestiario:bestiario_dev@localhost:5432/bestiario?schema=public"

# Use uma chave longa e aleatória no backend de autenticação
AUTH_SECRET="troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres"

# URL pública do backend quando o login for implementado
API_URL="http://localhost:3000"

# Frontend: usado pelo build Vite para chamar a API
VITE_API_URL="http://localhost:3000"

# Backend OAuth do GitHub — crie em GitHub Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"
PORT="3000"
NODE_ENV="development"
COOKIE_SAME_SITE="lax"

# URL do frontend local ou publicado no GitHub Pages
FRONTEND_URL="http://localhost:5173"
