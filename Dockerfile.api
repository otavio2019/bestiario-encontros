FROM node:22-alpine
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json ./
COPY server ./server
RUN pnpm db:generate

ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "pnpm db:deploy && pnpm api:start"]
