{
  "name": "bestiario-encontros",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Biblioteca local e calculadora de encontros para D&D 5e 2014 e D&D 2024.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "api:dev": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.1.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^0.453.0",
    "pg": "^8.23.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.18.0"
}
